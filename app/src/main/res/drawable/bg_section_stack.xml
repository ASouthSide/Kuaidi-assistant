<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack">
    <item android:left="14dp" android:top="10dp" android:right="14dp">
        <shape>
            <solid android:color="@color/ui_stack_back" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="7dp" android:top="6dp" android:right="7dp" android:bottom="3dp">
        <shape>
            <solid android:color="@color/ui_stack_middle" />
            <stroke android:width="1dp" android:color="@color/ui_line" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="7dp" android:drawable="@drawable/bg_glass_surface" />
</layer-list>
