<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/directory_drawer"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_glass_canvas">

    <FrameLayout android:id="@+id/dashboard_root"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/dashboard_wallpaper"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" android:scaleType="centerCrop" />
        <View android:id="@+id/wallpaper_scrim"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:alpha="0.49" android:background="@color/ui_background" android:visibility="gone" />
        <LinearLayout
            android:id="@+id/dashboard_content"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingTop="7dp">
                <ImageButton
                    android:id="@+id/btn_directory"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_splash_glass"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:contentDescription="打开目录"
                    android:padding="11dp" android:scaleType="fitCenter"
                    android:src="@drawable/ic_directory_menu" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_idcode" style="@style/Widget.Kuaidi.GlassNavigationEntry" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:text="身份码" />
            </LinearLayout>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/dashboard_deck"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        
            <LinearLayout
                android:id="@+id/deck_navigation"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginVertical="6dp"
                android:background="@drawable/bg_splash_glass"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingHorizontal="5dp" android:paddingVertical="3dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deck_packages" android:saveEnabled="false"
                    style="@style/Widget.Kuaidi.GlassNavigationTab"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:minWidth="0dp" android:paddingHorizontal="3dp"
                    android:maxLines="1" android:text="取件" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deck_shortcuts" android:saveEnabled="false"
                    style="@style/Widget.Kuaidi.GlassNavigationTab"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:minWidth="0dp" android:paddingHorizontal="3dp"
                    android:maxLines="1" android:text="快捷" />

                <ImageButton
                    android:id="@+id/deck_home"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_home_tab"
                    android:contentDescription="回到首页"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dashboard_home" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deck_rules" android:saveEnabled="false"
                    style="@style/Widget.Kuaidi.GlassNavigationTab"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:minWidth="0dp" android:paddingHorizontal="3dp"
                    android:maxLines="1" android:text="规则" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deck_settings" android:saveEnabled="false"
                    style="@style/Widget.Kuaidi.GlassNavigationTab"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:minWidth="0dp" android:paddingHorizontal="3dp"
                    android:maxLines="1" android:text="设置" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/directory_items"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginVertical="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_splash_glass"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/directory_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/directory_links"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_navigation"
            style="@style/Widget.Kuaidi.GlassNavigationEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_directory_edit"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#244978"
            android:text="编辑导航栏" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
